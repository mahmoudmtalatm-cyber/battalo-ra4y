rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function inRoom() { return resource.data.u0 == me() || resource.data.u1 == me(); }
    function mine() { return resource.data.from == me() || resource.data.to == me(); }
    function oldVal(f) { return resource == null ? 0 : resource.data[f]; }
    function upBy(f, n) {
      return request.resource.data[f] >= oldVal(f) && request.resource.data[f] <= oldVal(f) + n;
    }

    match /players/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && id == me()
        && request.resource.data.keys().hasOnly(['name', 'ts', 'room'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 16
        && request.resource.data.ts is timestamp;
      allow delete: if signedIn() && id == me();
    }

    match /chat/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'name', 'text', 'ts'])
        && request.resource.data.from == me()
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 300
        && request.resource.data.ts == request.time;
    }

    match /invites/{id} {
      allow get: if signedIn() && mine();
      allow list: if signedIn() && resource.data.to == me();
      allow create: if signedIn()
        && request.resource.data.from == me()
        && request.resource.data.status == 'pending'
        && request.resource.data.ts == request.time;
      allow update: if signedIn() && mine();
      allow delete: if signedIn() && mine();
    }

    match /rooms/{id} {
      allow get: if signedIn() && inRoom();
      allow create: if signedIn()
        && (request.resource.data.u0 == me() || request.resource.data.u1 == me());
      allow update: if signedIn() && inRoom();
      allow delete: if signedIn() && inRoom();
    }

    match /leaderboard/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && id == me()
        && request.resource.data.keys().hasOnly(['name', 'points', 'wins', 'games', 'ts'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 16
        && upBy('points', 25)
        && upBy('wins', 1)
        && upBy('games', 1)
        && request.resource.data.ts == request.time
        && (resource == null || request.time >= resource.data.ts + duration.value(3, 's'));
    }
  }
}
